
RewriteEngine On

# KAT-DOMAIN1 (2026-07-28): the standalone-deploy test (pat.katomia.com,
# docroot m/katomia/build) reads its HAPI env from m/katomia/.env_hapi
# (hapi_base.php looks at dirname(DOCUMENT_ROOT)) — never serve it over http.
<Files ".env_hapi">
  Require all denied
</Files>

# KAT-DOMAIN1: standalone-deploy diagnostics land in m/katomia/logs/ (kflow/kdiag
# write dirname(docroot)/logs) — never serve them
RewriteRule ^logs/ - [F]


RewriteRule ^game/(.+\.(js|css))$ $1 [L,QSA]
RewriteRule ^game/([^/]+)/?$ ?game=$1 [L,QSA,E=TRACE:TY63433]
RewriteRule ^create/?$ ?page=create [L,QSA,E=TRACE:RJ23394]

# BOARD-UI1 2026-07-11: clean route for the proposal board — /board/<id> instead
# of board.php?game=<id>. ?skin=… stays a query param (QSA merges it through).
# Asset rule mirrors the ^game/ one above: any relative "file.ext" URL the
# browser resolves against /board/<id> needs rewriting back to the real
# sibling file. BOARD-CLEANUP3: this went out js|css-only and 404'd the ring
# hub's K-logo (assets/kpay-k.svg) — the JS source is now fixed to an
# absolute path (the real fix), but covering common asset extensions here too
# as a safety net for anything else still using a relative path.
RewriteRule ^board/(.+\.(js|css|svg|png|jpe?g|gif|webp|ico))$ $1 [L,QSA]
RewriteRule ^board/([^/]+)/?$ board.php?game=$1 [L,QSA,E=TRACE:KB18204]

# KATOMIA-CONFIG1 2026-07-14: new curated-games landing page. Deliberately an
# OPT-IN path, not the site's default root — whether Landing ever REPLACES
# the default (bare /m/katomia/ → contents.php) is still an open product
# decision (user: "I'm not sure yet... we might do both over time"). This
# route exists so the page can be reviewed/linked without touching the
# existing default at all.
RewriteRule ^welcome/?$ landing.php [L,QSA]

# ENTRY-DEFAULTROOT1 (2026-07-29): welcome IS the default root now (index.php serves
# landing.php bare); the games list moved to this explicit route.
RewriteRule ^markets/?$ ?page=markets [L,QSA]

# ENTRY-CIRCLES1 (2026-07-30): the normal-mode index — proposal-mode games only, card
# view (circles.php). Distinct from /markets, which keeps the unfiltered grid behind
# the nerd-only link. The PATH is deliberately fixed even though the displayed word is
# a config parameter (site-config.json terms.space): renaming the term must not 404
# links people have already shared. If a rename ever wants a matching URL, add an alias
# line here pointing at the same target — don't move this one.
RewriteRule ^circles/?$ ?page=circles [L,QSA]
# ENTRY-LEARN1 (2026-07-30): the explainer + FAQ page ("what is a circle?"). Fixed
# path for the same reason as /circles — the displayed term is a parameter, shared
# links must not 404 when it changes.
RewriteRule ^learn/?$ ?page=learn [L,QSA]
# CIRCLE-HOSTPAGE1 (2026-08-08): the host console — edit the circles you own. Fixed path
# for the same reason as /circles and /learn: the displayed term is a config parameter,
# shared links must not 404 when it changes.
RewriteRule ^host/?$ ?page=host [L,QSA]
# KATOMIA-MCP5 (2026-09-15): the advisor help page. Fixed path for the same reason as
# /circles and /learn — this is the address we hand out, and a shared link must not 404.
RewriteRule ^advisor/?$ ?page=advisor [L,QSA]



# KBUNDLE-STRIP:kea
RewriteRule ^kea/?$ KEA [L,QSA]


RewriteRule ^keakonnect/?$ kea-bind.html [L,QSA]
# /KBUNDLE-STRIP:kea



#hapi api router
# CIRCLE-HOSTPAGE1 (2026-08-08): widened from ^hapi/([a-z]+)/?$ — that matched a SINGLE
# all-lowercase segment, so any nested or id-bearing backend route was unreachable
# through the proxy (hapi/circle/update 404'd, and so did hapi/game/<ID>, since game ids
# are mixed case). Now allows letters, digits, / _ and -.
# SAFE BY OMISSION: hapi.php interpolates this straight into
# https://<hapi_base>/katomia/$action, and the class below has NO DOT — so "..", hidden
# files and traversal out of /katomia/ are all unexpressible. Do not add "." here.
RewriteRule ^hapi/([a-zA-Z0-9/_-]+)/?$ hapi.php?action=$1 [L,QSA,E=TRACE:DE73672]

#RewriteRule ^game/([^/]+)/?$ ?game=$1 [R=302,L]